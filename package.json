{
  "name": "ai-factory",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "e2e": "turbo e2e",
    "test": "turbo test",
    "factory:dev": "pnpm --filter @workspace/ia-factory dev",
    "factory:build": "pnpm --filter @workspace/ia-factory build",
    "factory:info": "pnpm --filter @workspace/ia-factory exec eve info",
    "factory:validate": "pnpm --filter @workspace/ia-factory validate"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
