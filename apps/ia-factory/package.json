{
  "name": "@workspace/ia-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "IA Factory: f\u00e1brica de software con IA sobre eve.",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "eval": "eve eval",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "validate": "eslint && tsc --noEmit && eve info",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/openai": "^4.0.108",
    "ai": "^7.0.120",
    "eve": "1.0.0-rc.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.19.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "globals": "^17.13.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "24.x"
  }
}
